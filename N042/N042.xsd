          <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectName="" DbObjectType="Unknown" GenerateShortCommands="true" GeneratorSourceName="InsertTanaoroshiJizenShukei" MethodsParameterType="CLR" Modifier="Public" Name="InsertTanaoroshiJizenShukei" QueryType="NoData" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetDataBy1" UserSourceName="InsertTanaoroshiJizenShukei">
            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT INTO  T_棚卸事前集計
              (棚卸年月,
               商品管理番号,
                在庫区分,
                 論理数量,
                  論理原価単価合計,
                   論理上代単価合計,
                    登録者番号,
                     登録日)
                     
SELECT            (SELECT       SUBSTRING(コード名称,1,6)
                           FROM  M_コード
                         WHERE       大区分 = '930'
                             AND        中区分 = '002'),
 ZAIKO.商品管理番号,
  ZAIKO.在庫区分,
   SUM(ZAIKO.数量) AS 論理数量,
    SUM(ZAIKO.数量 * SHOUHIN.原価単価) AS 論理原価単価合計,
    SUM(ZAIKO.数量 * SHOUHIN.上代単価) AS 論理上代単価合計,
     'BAT' AS Expr2, 
     GETDATE() AS Expr3
FROM              T_在庫 AS ZAIKO INNER JOIN
                        M_商品 AS SHOUHIN ON ZAIKO.商品管理番号 = SHOUHIN.商品管理番号
GROUP BY      ZAIKO.商品管理番号, ZAIKO.在庫区分</CommandText>
                <Parameters />
              </DbCommand>
            </InsertCommand>
          </DbSource>
