            <DeleteCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>DELETE FROM [T_棚卸事前集計]
WHERE [棚卸年月] = (SELECT       SUBSTRING(コード名称,1,6)
