            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>insert into T_月初在庫(
			商品管理番号,
			仕入伝票番号,
			在庫年月,
			数量,
			群コード,
			[3桁品番],
			フロアコード,
			仕入先コード,
			原価単価合計,
			上代単価合計,
			登録者番号,
			登録日,
			更新者番号,
			更新日)

SELECT	 MSHOHIN.商品管理番号
		,'0000000000' AS 仕入伝票番号
		,@当月在庫年月 AS 在庫年月
		,(ISNULL(TGESHO.月初個数,0) + ISNULL(SHIIRE.数量,0)) - (ISNULL(THIBETU.数量,0)) AS 合計数量
		,MSHOHIN.群コード
		,MSHOHIN.[3桁品番]
		,MSHOHIN.フロアコード
		,MSHOHIN.仕入先コード
		,(ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0)) - ISNULL(SHIIRE.廃棄原価,0) AS 月末原価
		,(ISNULL(TGESHO.月首上代,0) + ISNULL(SHIIRE.仕入上代,0)) - ISNULL(THIBETU.上代売上,0) - ISNULL(SHIIRE.廃棄上代,0) AS 月末上代
		,'N020' AS 登録者番号
		,GETDATE() AS 登録日
		,null AS 更新者番号
		,null AS 更新日

FROM	 M_商品 MSHOHIN
LEFT OUTER JOIN (SELECT	 TGESHO.商品管理番号
						,SUM(CASE WHEN TGESHO.在庫年月 = @前月在庫年月 THEN TGESHO.原価単価合計 ELSE 0 END) 月首原価
						,SUM(CASE WHEN TGESHO.在庫年月 = @前月在庫年月 THEN TGESHO.上代単価合計 ELSE 0 END) 月首上代 
						,SUM(CASE WHEN TGESHO.在庫年月 = @前月在庫年月 THEN TGESHO.数量 ELSE 0 END) 月初個数 
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月在庫年月 THEN TGESHO.原価単価合計 ELSE 0 END) 月末原価
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月在庫年月 THEN TGESHO.上代単価合計 ELSE 0 END) 月末上代 
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月在庫年月 THEN TGESHO.数量 ELSE 0 END) 月末個数 
				 FROM	 T_月初在庫 TGESHO 
				 WHERE	 TGESHO.在庫年月 IN ( @前月在庫年月 , @当月在庫年月 )
				 GROUP BY TGESHO.商品管理番号) TGESHO
				 ON MSHOHIN.商品管理番号 = TGESHO.商品管理番号
LEFT OUTER JOIN (SELECT	 MSHOHIN.商品管理番号
						,SUM(CASE WHEN TSHIIRE.仕入区分 &lt;&gt; '9' THEN TSHIIREM.数量 * TSHIIREM.原価単価 ELSE 0 END) 仕入原価
						,SUM(CASE WHEN TSHIIRE.仕入区分 &lt;&gt; '9' THEN TSHIIREM.数量 * TSHIIREM.上代単価 ELSE 0 END) 仕入上代
						,SUM(CASE WHEN TSHIIRE.仕入区分 = '9' THEN TSHIIREM.数量 * TSHIIREM.上代単価 * -1 ELSE 0 END) 廃棄上代
						,SUM(CASE WHEN TSHIIRE.仕入区分 = '9' THEN TSHIIREM.数量 * TSHIIREM.原価単価 * -1 ELSE 0 END) 廃棄原価
						,SUM(TSHIIREM.数量) 数量	
				 FROM	 T_仕入 TSHIIRE
				 INNER JOIN T_仕入明細 TSHIIREM ON TSHIIRE.仕入伝票番号 = TSHIIREM.仕入伝票番号
											   AND TSHIIRE.赤黒枝番 = TSHIIREM.赤黒枝番
				 INNER JOIN M_商品 MSHOHIN ON TSHIIREM.商品管理番号 = MSHOHIN.商品管理番号
				 WHERE	 TSHIIRE.集計年月 = @集計年月
				 GROUP BY MSHOHIN.商品管理番号) SHIIRE
				 ON MSHOHIN.商品管理番号 = SHIIRE.商品管理番号
LEFT OUTER JOIN (SELECT	 THIBETU.商品管理番号
						,SUM(THIBETU.下代金額計) 売価売上
						,SUM(THIBETU.下代金額計) - SUM(THIBETU.粗利金額計) 原価売上
						,SUM(THIBETU.上代金額計) 上代売上
						,SUM(THIBETU.粗利金額計) 粗利金額
						,SUM(THIBETU.数量計) 数量
						,(SELECT SUM(下代金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月在庫年月) 当月売上
						,(SELECT SUM(下代金額計) - SUM(粗利金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月在庫年月) 当月原価
						,(SELECT SUM(粗利金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月在庫年月) 当月粗利
				 FROM	 T_商品月別実績 THIBETU
				 INNER JOIN M_商品 MSHOHIN ON THIBETU.商品管理番号 = MSHOHIN.商品管理番号
				 WHERE	 THIBETU.対象年月 = @前月在庫年月
				 GROUP BY THIBETU.商品管理番号) THIBETU 
				 ON MSHOHIN.商品管理番号 = THIBETU.商品管理番号

		,(SELECT TOGETUDAY.対象月日数 - KYUGYODAY.休業日 営業日数
		  FROM	 (SELECT  CAST(DAY(CAST((CAST(YEAR(@当月在庫年月 + '01') AS VARCHAR(4))+'-'+CAST(MONTH(@当月在庫年月 + '01') AS VARCHAR(2))+'-1') AS DATETIME)-1)AS VARCHAR) 対象月日数) TOGETUDAY
				,(SELECT	 COUNT(年月日) 休業日	
				 FROM	 M_カレンダ MCALENDER
				 WHERE	 MCALENDER.営業フラグ = 0
				 AND	 SUBSTRING(MCALENDER.年月日,1,6) = @前月在庫年月) KYUGYODAY ) EIGYODAYCOUNT	
	 
		</CommandText>
                <Parameters>
                  <Parameter AllowDbNull="false" AutogeneratedName="当月在庫年月" ColumnName="" DataSourceName="" DataTypeServer="unknown" DbType="AnsiString" Direction="Input" ParameterName="@当月在庫年月" Precision="0" Scale="0" Size="1024" SourceColumn="" SourceColumnNullMapping="false" SourceVersion="Current" />
                  <Parameter AllowDbNull="false" AutogeneratedName="前月在庫年月" ColumnName="" DataSourceName="" DataTypeServer="unknown" DbType="String" Direction="Input" ParameterName="@前月在庫年月" Precision="0" Scale="0" Size="1024" SourceColumn="" SourceColumnNullMapping="false" SourceVersion="Current" />
                  <Parameter AllowDbNull="true" AutogeneratedName="集計年月" ColumnName="" DataSourceName="" DataTypeServer="nchar(6)" DbType="String" Direction="Input" ParameterName="@集計年月" Precision="0" Scale="0" Size="6" SourceColumn="" SourceColumnNullMapping="false" SourceVersion="Current" />
                </Parameters>
              </DbCommand>
            </InsertCommand>
          </DbSource>
