            <UpdateCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>UPDATE T_月別効率表
SET 在庫数量 = GESYO.数量,
	在庫原価合計 = GESYO.原価,
	在庫上代合計 = GESYO.上代

FROM T_月別効率表
INNER JOIN (SELECT 商品管理番号,
				SUM(数量) AS 数量,
				SUM(原価単価合計) AS 原価,
				SUM(上代単価合計) AS 上代 
			FROM T_月初在庫
			WHERE 在庫年月 = @当月
			GROUP BY 商品管理番号) GESYO
ON T_月別効率表.商品管理番号 = GESYO.商品管理番号

WHERE T_月別効率表.集計年月 = @前月
</CommandText>
                <Parameters>
                  <Parameter AllowDbNull="false" AutogeneratedName="前月" ColumnName="集計年月" DataSourceName="tnb.dbo.T_月別効率表" DataTypeServer="nchar(6)" DbType="String" Direction="Input" ParameterName="@前月" Precision="0" ProviderType="NChar" Scale="0" Size="6" SourceColumn="集計年月" SourceColumnNullMapping="false" SourceVersion="Current" />
