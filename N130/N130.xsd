          <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectName="" DbObjectType="Unknown" GenerateShortCommands="true" GeneratorSourceName="InsertShiiresakiTsukibetsuJissekiZenki" MethodsParameterType="CLR" Modifier="Public" Name="InsertShiiresakiTsukibetsuJissekiZenki" QueryType="NoData" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetDataBy2" UserSourceName="InsertShiiresakiTsukibetsuJissekiZenki">
            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT INTO T_仕入先月別実績
    (対象年月, 期, 仕入先コード, 仕入先履歴番号, フロアコード, 仕入金額計, 売上金額計, 粗利金額計, 上代金額計, 数量計, 登録者番号, 登録日)
SELECT  @対象年月,
	(SELECT      コード名称
	FROM        M_コード
	WHERE       (大区分 = '920') AND (中区分 = '002')),
	URIAGE.仕入先コード,
	URIAGE.仕入先履歴番号,
	URIAGE.フロアコード,
	SUM(URIAGE.原価単価 * URIAGE.数量), 
	SUM(URIAGE.下代単価 * URIAGE.数量), 
	SUM(URIAGE.下代単価 * URIAGE.数量 - URIAGE.原価単価 * URIAGE.数量), 
	SUM(URIAGE.上代単価 * URIAGE.数量) AS 上代金額計, SUM(URIAGE.数量), 
	N'BAT',
	GETDATE()
FROM	V_売上 AS URIAGE
INNER JOIN M_フロア AS HUROA ON URIAGE.フロアコード = HUROA.フロアコード
WHERE       (trim(@対象年月) + '01' &lt;= URIAGE.売上年月日)
	AND (URIAGE.売上年月日 &lt;= trim(@対象年月) + '31')
	AND (HUROA.フロアコード &lt;&gt; '9')
GROUP BY   URIAGE.仕入先コード, URIAGE.仕入先履歴番号, URIAGE.フロアコード</CommandText>
                <Parameters>
                  <Parameter AllowDbNull="true" AutogeneratedName="対象年月" ColumnName="売上年月日" DataSourceName="tnb.dbo.V_売上" DataTypeServer="nchar(8)" DbType="String" Direction="Input" ParameterName="@対象年月" Precision="0" ProviderType="NChar" Scale="0" Size="8" SourceColumn="売上年月日" SourceColumnNullMapping="false" SourceVersion="Current" />
