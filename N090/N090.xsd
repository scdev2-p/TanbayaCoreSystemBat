                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT          URIAGE.顧客管理番号,
	      URIAGE.フロアコード,
                    SUM(URIAGE.下代単価 * URIAGE.数量) AS 売上金額

   FROM      V_売上 URIAGE

INNER JOIN M_フロア HUROA ON URIAGE.フロアコード = HUROA.フロアコード

WHERE           SUBSTRING(URIAGE.売上年月日,1,6) = @対象年月
    AND           URIAGE.顧客管理番号 &lt;&gt; ''
    AND           URIAGE.フロアコード &lt;&gt; '9'

GROUP BY      URIAGE.顧客管理番号,URIAGE.フロアコード

ORDER BY      URIAGE.顧客管理番号,売上金額 DESC;</CommandText>
