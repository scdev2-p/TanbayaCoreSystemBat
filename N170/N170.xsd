          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="品番別効率表TableAdapter" GeneratorDataComponentClassName="品番別効率表TableAdapter" Name="品番別効率表" UserDataComponentName="品番別効率表TableAdapter">
            <MainSource>
              <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectType="Unknown" GenerateMethods="Get" GenerateShortCommands="false" GeneratorGetMethodName="SelectKourituList" GetMethodModifier="Public" GetMethodName="SelectKourituList" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="SelectKourituList" UserSourceName="SelectKourituList">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT	 MSHOHIN.フロアコード
		,MSHOHIN.フロア名
		,MSHOHIN.品番
		,MSHOHIN.商品グループ名カナ 
		,ISNULL(TGESHO.月首原価,0) 月首原価
		,ISNULL(TGESHO.月首上代,0) 月首上代
		,ISNULL(SHIIRE.仕入原価,0) 仕入原価
		,ISNULL(SHIIRE.仕入上代,0) 仕入上代
		,ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0) 原価合計
		,ISNULL(TGESHO.月首上代,0) + ISNULL(SHIIRE.仕入上代,0) 上代合計
		,ISNULL(TGESHO.月末原価,0) 月末原価
		,ISNULL(TGESHO.月末上代,0) 月末上代
		,(ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - ISNULL(SHIIRE.廃棄原価,0) - ISNULL(THIBETU.原価売上,0) 月末原価_棚卸
		,(ISNULL(TGESHO.月首上代,0) + ISNULL(SHIIRE.仕入上代,0)) - ISNULL(SHIIRE.廃棄上代,0) - ISNULL(THIBETU.上代売上,0) 月末上代_棚卸
		,ISNULL(TTANA.棚卸前数量,0) 月末個数
		,ISNULL(THIBETU.原価売上,0) 原価売上
		,ISNULL(THIBETU.上代売上,0)	上代売上
		,ISNULL(THIBETU.粗利金額,0)	粗利金額
		,ISNULL(THIBETU.売価売上,0)	売価売上
		,CASE WHEN ISNULL(THIBETU.当月売上,0) = 0 THEN NULL ELSE ISNULL(THIBETU.売価売上,0) / ISNULL(THIBETU.当月売上,0) END 売上構成比
		,CASE WHEN ISNULL(THIBETU.当月粗利,0) = 0 THEN NULL ELSE ISNULL(THIBETU.粗利金額,0) / ISNULL(THIBETU.当月粗利,0) END 粗利構成比
		,CASE WHEN ISNULL(THIBETU.売価売上,0) = 0 THEN NULL ELSE ISNULL(THIBETU.粗利金額,0) / ISNULL(THIBETU.売価売上,0) END 粗利率
		,ISNULL(SHIIRE.廃棄上代,0) 廃棄上代
				,CASE WHEN ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0))) = 0 THEN NULL
			ELSE ISNULL(THIBETU.売価売上,0) / ((ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0)))) / 2) END 回転率
		,CASE WHEN ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0))) = 0 OR ISNULL(THIBETU.売価売上,0) = 0 THEN NULL
			ELSE EIGYODAYCOUNT.営業日数 / (ISNULL(THIBETU.売価売上,0) / ((ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0)))) / 2)) END 在庫日数
		,CASE WHEN ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0))) = 0 THEN NULL
			ELSE ISNULL(THIBETU.粗利金額,0) / (ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0)))) * 2 END 交差率
		,CASE WHEN ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0))) = 0 OR ISNULL(THIBETU.粗利金額,0) = 0 THEN NULL
			ELSE EIGYODAYCOUNT.営業日数 / (ISNULL(THIBETU.粗利金額,0) / ((ISNULL(TGESHO.月首原価,0) + ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - (ISNULL(THIBETU.売価売上,0) - ISNULL(THIBETU.粗利金額,0)))) / 2)) END 交差日数
		,ISNULL(TTANAA.棚卸後原価,0) 実質原価
		,ISNULL(TTANAA.棚卸後原価,0) - ((ISNULL(TGESHO.月首原価,0) + ISNULL(SHIIRE.仕入原価,0)) - ISNULL(SHIIRE.廃棄原価,0) - ISNULL(THIBETU.原価売上,0)) 原価差額
		,ISNULL(TTANAA.棚卸後上代,0) 実質上代
		,ISNULL(TTANAA.棚卸後上代,0) - ((ISNULL(TGESHO.月首上代,0) + ISNULL(SHIIRE.仕入上代,0)) - ISNULL(SHIIRE.廃棄上代,0) - ISNULL(THIBETU.上代売上,0)) 上代差額
		,ISNULL(TTANAA.棚卸後数量,0) 実質個数
		,ISNULL(TTANAA.棚卸後数量,0) - ISNULL(TTANA.棚卸前数量,0) 個数差
		,EIGYODAYCOUNT.営業日数
FROM	(SELECT	 CASE WHEN SUBSTRING(MSHOHING.フロアコード + MSHOHING.商品グループコード,1,2) = '99'
					THEN '99*'
					ELSE MSHOHING.フロアコード + '**' 
				 END フロアコード
				,MFLOOR.フロア名
				,MSHOHING.フロアコード + MSHOHING.商品グループコード [3桁品番]
				,MSHOHING.フロアコード + MSHOHING.商品グループコード 品番
				,MSHOHING.商品グループ名カナ
		 FROM	 M_商品グループ MSHOHING
		 INNER JOIN M_フロア MFLOOR ON MSHOHING.フロアコード = MFLOOR.フロアコード
		 GROUP BY CASE WHEN SUBSTRING(MSHOHING.フロアコード + MSHOHING.商品グループコード,1,2) = '99'
					THEN '99*'
					ELSE MSHOHING.フロアコード + '**' 
				 END
				,MFLOOR.フロア名
				,MSHOHING.フロアコード + MSHOHING.商品グループコード
				,MSHOHING.商品グループ名カナ) MSHOHIN
LEFT OUTER JOIN (SELECT	 TGESHO.[3桁品番]
						,SUM(CASE WHEN TGESHO.在庫年月 = @前月 THEN TGESHO.原価単価合計 ELSE 0 END) 月首原価
						,SUM(CASE WHEN TGESHO.在庫年月 = @前月 THEN TGESHO.上代単価合計 ELSE 0 END) 月首上代 
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月 THEN TGESHO.原価単価合計 ELSE 0 END) 月末原価
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月 THEN TGESHO.上代単価合計 ELSE 0 END) 月末上代 
						,SUM(CASE WHEN TGESHO.在庫年月 = @当月 THEN TGESHO.数量 ELSE 0 END) 月末個数 
				 FROM	 T_月初在庫 TGESHO 
				 WHERE	 TGESHO.在庫年月 IN ( @前月 , @当月 )
				 GROUP BY TGESHO.[3桁品番]) TGESHO
				 ON MSHOHIN.[3桁品番] = TGESHO.[3桁品番]
LEFT OUTER JOIN (SELECT	 MSHOHIN.[3桁品番]
						,SUM(CASE WHEN TSHIIRE.仕入区分 &lt;&gt; '9' THEN TSHIIREM.数量 * TSHIIREM.原価単価 ELSE 0 END) 仕入原価
						,SUM(CASE WHEN TSHIIRE.仕入区分 &lt;&gt; '9' THEN TSHIIREM.数量 * TSHIIREM.上代単価 ELSE 0 END) 仕入上代
						,SUM(CASE WHEN TSHIIRE.仕入区分 = '9' THEN TSHIIREM.数量 * TSHIIREM.原価単価 * -1 ELSE 0 END) 廃棄原価
						,SUM(CASE WHEN TSHIIRE.仕入区分 = '9' THEN TSHIIREM.数量 * TSHIIREM.上代単価 * -1 ELSE 0 END) 廃棄上代
				 FROM	 T_仕入 TSHIIRE
				 INNER JOIN T_仕入明細 TSHIIREM ON TSHIIRE.仕入伝票番号 = TSHIIREM.仕入伝票番号
											   AND TSHIIRE.赤黒枝番 = TSHIIREM.赤黒枝番
				 INNER JOIN M_商品 MSHOHIN ON TSHIIREM.商品管理番号 = MSHOHIN.商品管理番号
				 WHERE	 TSHIIRE.集計年月 = @前月
				 GROUP BY MSHOHIN.[3桁品番]) SHIIRE
				 ON MSHOHIN.[3桁品番] = SHIIRE.[3桁品番]
LEFT OUTER JOIN (SELECT	 THIBETU.[3桁品番]
						,SUM(THIBETU.下代金額計) 売価売上
						,SUM(THIBETU.下代金額計) - SUM(THIBETU.粗利金額計) 原価売上
						,SUM(THIBETU.上代金額計) 上代売上
						,SUM(THIBETU.粗利金額計) 粗利金額
						,(SELECT SUM(下代金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月) 当月売上
						,(SELECT SUM(下代金額計) - SUM(粗利金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月) 当月原価
						,(SELECT SUM(粗利金額計) FROM T_商品月別実績 WHERE 対象年月 = @前月) 当月粗利
				 FROM	 T_商品月別実績 THIBETU
				 WHERE	 THIBETU.対象年月 = @前月
				 GROUP BY THIBETU.[3桁品番]) THIBETU 
				 ON MSHOHIN.[3桁品番] = THIBETU.[3桁品番] 
LEFT OUTER JOIN (SELECT	 MSHOHIN.[3桁品番]
						,SUM(TTANA.論理原価単価合計) 棚卸前原価
						,SUM(TTANA.論理上代単価合計) 棚卸前上代
						,SUM(TTANA.論理数量) 棚卸前数量
				 FROM	 T_棚卸事前集計 TTANA
				 INNER JOIN M_商品 MSHOHIN ON TTANA.商品管理番号 = MSHOHIN.商品管理番号
				 WHERE	 TTANA.棚卸年月 = @前月
				 GROUP BY MSHOHIN.[3桁品番]) TTANA 
				 ON MSHOHIN.[3桁品番] = TTANA.[3桁品番] 
LEFT OUTER JOIN (SELECT	 MSHOHIN.[3桁品番]
						,SUM(TTANA.原価単価合計) 棚卸後原価
						,SUM(TTANA.上代単価合計) 棚卸後上代
						,SUM(TTANA.数量) 棚卸後数量
				 FROM	 T_棚卸明細 TTANA
				 INNER JOIN M_商品 MSHOHIN ON TTANA.商品管理番号 = MSHOHIN.商品管理番号
				 WHERE	 TTANA.棚卸年月 = @前月
				 GROUP BY MSHOHIN.[3桁品番]) TTANAA 
				 ON MSHOHIN.[3桁品番] = TTANAA.[3桁品番]  
		,(SELECT TOGETUDAY.対象月日数 - KYUGYODAY.休業日 営業日数
		  FROM	 (SELECT  CAST(DAY(CAST((CAST(YEAR(@当年月日) AS VARCHAR(4))+'-'+CAST(MONTH(@当年月日) AS VARCHAR(2))+'-1') AS DATETIME)-1)AS VARCHAR) 対象月日数) TOGETUDAY
				,(SELECT	 COUNT(年月日) 休業日	
				 FROM	 M_カレンダ MCALENDER
				 WHERE	 MCALENDER.営業フラグ = 0
				 AND	 SUBSTRING(MCALENDER.年月日,1,6) = @前月) KYUGYODAY ) EIGYODAYCOUNT	 
ORDER BY 品番
</CommandText>
                    <Parameters>
                      <Parameter AllowDbNull="false" AutogeneratedName="前月" ColumnName="" DataSourceName="" DataTypeServer="unknown" DbType="String" Direction="Input" ParameterName="@前月" Precision="0" Scale="0" Size="1024" SourceColumn="" SourceColumnNullMapping="false" SourceVersion="Current" />
