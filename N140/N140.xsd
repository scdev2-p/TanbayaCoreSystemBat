            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>SELECT  @対象年月,
	       (SELECT コード名称 
	           FROM M_コード 
	         WHERE 大区分 = '920'
	             AND 中区分 = '001') AS 期,
	       s.商品管理番号,
	       s.種別,
	       s.群コード,
	       u.フロアコード,
	       u.フロアコード + u.商品グループコード AS [3桁品番], 
	       s.[5桁品番],
	       s.[8桁品番],
	       s.商品コード,
	       s.バーコード,
	       s.仕入先コード,
	       s.仕入先履歴番号,
	       SUM(u.原価単価 * u.数量)  AS 原価金額計,
	       SUM(u.上代単価 * u.数量)  AS 上代金額計,
	       SUM(u.販売金額)  AS 下代金額計,
		   SUM(u.販売金額 - 
					u.原価単価 * u.数量)  AS 粗利金額計,
		   0                          AS 数量計,
		   'N140',
	       GETDATE(),
	       NULL,
	       NULL
FROM M_商品 S
INNER JOIN T_セット売上 U ON  U.商品管理番号 = S.商品管理番号
WHERE	       @対象年月 + '01' &lt;= U.売上年月日
    AND           U.売上年月日 &lt;= @対象年月 + '31' 
    AND U.フロアコード NOT IN ('+','T')
    
    
  GROUP BY    s.商品管理番号,
			s.種別,
			s.群コード,
	        u.フロアコード,
	        u.商品グループコード,
			s.[5桁品番],
			s.[8桁品番],
			s.商品コード,
			s.バーコード,
			s.仕入先コード,
			s.仕入先履歴番号
</CommandText>
