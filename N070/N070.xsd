            <MainSource>
              <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectType="Unknown" GenerateMethods="Get" GenerateShortCommands="false" GeneratorGetMethodName="SelectFloorUriageBest10" GetMethodModifier="Public" GetMethodName="SelectFloorUriageBest10" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="SelectFloorUriageBest10" UserSourceName="SelectFloorUriageBest10">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT	 TOP 10 TURIAGE.フロアコード
		,TURIAGE.[8桁品番] 商品コード
		,MSHOHING.商品グループ名 商品名
		,MAX(TURIAGE.上代単価) 上代単価
		,'' ゾーン
		,SUM(TURIAGE.数量) 数量
		,SUM(TURIAGE.販売金額) 売上金額
FROM	 T_売上 TURIAGE
INNER JOIN M_商品グループ MSHOHING ON TURIAGE.フロアコード = MSHOHING.フロアコード
								  AND TURIAGE.商品グループコード = MSHOHING.商品グループコード
WHERE	 TURIAGE.売上年月日 BETWEEN @売上年月日FROM AND @売上年月日TO
AND		 TURIAGE.フロアコード = @フロアコード
GROUP BY TURIAGE.フロアコード
		,TURIAGE.[8桁品番]
		,MSHOHING.商品グループ名
ORDER BY 売上金額 DESC

</CommandText>
