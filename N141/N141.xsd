	        [8桁品番],
	        商品コード,
	        バーコード,
	        仕入先コード,
	        仕入先履歴番号,
                      原価金額計,
                      上代金額計,
	        下代金額計,
	        粗利金額計,
	        数量計,
	        登録者番号,
	        登録日
	       )

SELECT          @対象年月,
	       (SELECT コード名称 
	           FROM M_コード 
	         WHERE 大区分 = '920'
	             AND 中区分 = '001') AS 期,
	       URIAGE.商品管理番号,
	       SHOUHIN.種別,
	       SHOUHIN.群コード,
	       URIAGE.フロアコード,
	       URIAGE.[3桁品番],
	       SHOUHIN.[5桁品番],
	       SHOUHIN.[8桁品番],
	       SHOUHIN.商品コード,
	       SHOUHIN.バーコード,
	       SHOUHIN.仕入先コード,
	       SHOUHIN.仕入先履歴番号,
	       SUM(URIAGE.原価単価 * URIAGE.数量)  AS 原価金額計,
	       SUM(URIAGE.上代単価 * URIAGE.数量)  AS 上代金額計,
	       SUM(URIAGE.販売金額)  AS 下代金額計,
		   SUM(URIAGE.販売金額 - 
					URIAGE.原価単価 * URIAGE.数量)  AS 粗利金額計,
		   SUM(URIAGE.数量)                              AS 数量計,
		   'BAT',
	       GETDATE()

FROM        V_売上 URIAGE
INNER JOIN  M_商品 SHOUHIN ON URIAGE.商品管理番号 = SHOUHIN.商品管理番号 
INNER JOIN  M_フロア HUROA ON URIAGE.フロアコード = HUROA.フロアコード

WHERE	       @対象年月 + '01' &lt;= URIAGE.売上年月日
    AND           URIAGE.売上年月日 &lt;= @対象年月 + '31'

GROUP BY    URIAGE.商品管理番号,
			SHOUHIN.種別,
			SHOUHIN.群コード,
	        URIAGE.フロアコード,
	        URIAGE.[3桁品番],
			SHOUHIN.[5桁品番],
			SHOUHIN.[8桁品番],
			SHOUHIN.商品コード,
			SHOUHIN.バーコード,
			SHOUHIN.仕入先コード,
			SHOUHIN.仕入先履歴番号
</CommandText>
