                <InsertCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>INSERT INTO T_在庫
(商品管理番号, 仕入伝票番号, 数量, 在庫区分, 登録者番号, 登録日)

SELECT MEISAI.商品管理番号, MEISAI.仕入伝票番号, MEISAI.数量, MEISAI.在庫区分, 'N059', GETDATE()

FROM (
	SELECT 商品管理番号, 仕入伝票番号, SUM(ISNULL(数量,0)) AS 数量, '1' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND  '0' &lt; 棚番号 AND 棚番号 &lt; '9000'
				GROUP BY 商品管理番号, 仕入伝票番号
	UNION ALL
	SELECT 商品管理番号, 仕入伝票番号, SUM(ISNULL(数量,0)) AS 数量, '2' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND  '8999' &lt; 棚番号 AND 棚番号 &lt; '9500'
				GROUP BY 商品管理番号, 仕入伝票番号
	UNION ALL
	SELECT 商品管理番号, 仕入伝票番号, SUM(ISNULL(数量,0)) AS 数量, '3' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND  '9499' &lt; 棚番号 AND 棚番号 &lt; '10000'
				GROUP BY 商品管理番号, 仕入伝票番号
			
	) MEISAI
WHERE MEISAI.数量 &lt;&gt; 0
ORDER BY MEISAI.商品管理番号, MEISAI.在庫区分</CommandText>
                    <Parameters>
                      <Parameter AllowDbNull="false" AutogeneratedName="棚卸年月" ColumnName="" DataSourceName="" DataTypeServer="nchar(6)" DbType="String" Direction="Input" ParameterName="@棚卸年月" Precision="0" Scale="0" Size="6" SourceColumn="" SourceColumnNullMapping="false" SourceVersion="Current" />
