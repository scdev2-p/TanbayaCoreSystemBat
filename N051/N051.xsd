                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT @棚卸年月 AS 棚卸年月
	  ,'2999' AS 棚番号
	  ,TORIOKI.商品管理番号
      ,SHOHIN.仕入先コード
      ,SHOHIN.仕入先履歴番号
      ,TORIOKI.登録者番号 AS 担当者番号
      ,SUM(ISNULL(TORIOKI.数量,0)) AS 数量
      ,SUM(ISNULL(TORIOKI.数量,0) * ISNULL(SHOHIN.原価単価,0)) AS 原価単価合計
      ,SUM(ISNULL(TORIOKI.数量,0) * ISNULL(SHOHIN.上代単価,0)) AS 上代単価合計
      ,TORIOKI.フロアコード
      ,0 AS 処理済みフラグ
      ,'BAT' AS 登録者番号
      ,GETDATE() AS 登録日

FROM T_取置棚卸 TORIOKI

INNER JOIN M_商品 SHOHIN
ON SHOHIN.商品管理番号 = TORIOKI.商品管理番号

GROUP BY TORIOKI.商品管理番号
		,SHOHIN.仕入先コード
		,SHOHIN.仕入先履歴番号
		,TORIOKI.登録者番号
		,SHOHIN.原価単価
		,SHOHIN.上代単価
		,TORIOKI.数量
		,TORIOKI.フロアコード


ORDER BY TORIOKI.商品管理番号</CommandText>
