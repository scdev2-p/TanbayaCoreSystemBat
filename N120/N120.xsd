          <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectName="" DbObjectType="Unknown" GenerateShortCommands="true" GeneratorSourceName="InsertKokyakuTukibetuJisseki" MethodsParameterType="CLR" Modifier="Public" Name="InsertKokyakuTukibetuJisseki" QueryType="NoData" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetDataBy" UserSourceName="InsertKokyakuTukibetuJisseki">
            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT INTO  T_顧客月別実績(
	        対象年月,
	        期,
                      顧客管理番号,
	        顧客コード,
	        代表顧客コード,
	        原価金額計,
	        上代金額計,
	        下代金額計,
                      粗利金額計,
                      数量計,
	        登録日,
	        登録者番号)

SELECT          @対象年月,
	       (SELECT コード名称 
	           FROM M_コード 
	         WHERE 大区分 = '920'
	             AND 中区分 = '001'),
	        KOKYAKU.顧客管理番号,
	        KOKYAKU.顧客コード,
	        KOKYAKU.代表顧客コード,
	        SUM(URIAGE.原価単価 * URIAGE.数量)  AS 原価金額計,
	        SUM(URIAGE.上代単価 * URIAGE.数量)  AS 上代金額計,
	        SUM(URIAGE.販売金額)  AS 下代金額計,
                      SUM(URIAGE.販売金額 -
                             URIAGE.原価単価 * URIAGE.数量) AS 粗利金額計,
                      SUM(URIAGE.数量) AS 数量計,
	        GETDATE(),
	       'BAT'
  FROM        V_売上 URIAGE

  LEFT JOIN  M_顧客 KOKYAKU ON URIAGE.顧客管理番号 = KOKYAKU.顧客管理番号
INNER JOIN  M_フロア    HUROA ON URIAGE.フロアコード     = HUROA.フロアコード   

WHERE	 @対象年月 + '01' &lt;= URIAGE.売上年月日
    AND	     URIAGE.売上年月日 &lt;= @対象年月 + '31'
    AND	        KOKYAKU.顧客管理番号 &lt;&gt;  ''
    AND            URIAGE.フロアコード &lt;&gt; '9' 

GROUP BY       KOKYAKU.顧客管理番号,KOKYAKU.顧客コード,KOKYAKU.代表顧客コード</CommandText>
                <Parameters>
                  <Parameter AllowDbNull="true" AutogeneratedName="対象年月" ColumnName="売上年月日" DataSourceName="tnb.dbo.V_売上" DataTypeServer="nchar(8)" DbType="String" Direction="Input" ParameterName="@対象年月" Precision="0" ProviderType="NChar" Scale="0" Size="6" SourceColumn="売上年月日" SourceColumnNullMapping="false" SourceVersion="Current" />
                </Parameters>
              </DbCommand>
            </InsertCommand>
