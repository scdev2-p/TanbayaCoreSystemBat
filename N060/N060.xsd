            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT INTO M_月別顧客別売上 (
		 売上年月
		,顧客管理番号
		,売上金額
		,登録者番号
		,登録日 )
SELECT     @売上年月,
	       URIAGE.顧客管理番号,
	       SUM(URIAGE.販売金額)  AS 売上金額,
	       'BAT',
	       GETDATE()
FROM       V_売上 URIAGE
LEFT JOIN  M_顧客 KOKYAKU ON URIAGE.顧客管理番号 = KOKYAKU.顧客管理番号
INNER JOIN M_フロア    HUROA ON URIAGE.フロアコード     = HUROA.フロアコード   
WHERE	 @売上年月 + '01' &lt;= URIAGE.売上年月日
AND	     URIAGE.売上年月日 &lt;= @売上年月 + '31'
AND	     URIAGE.顧客管理番号 &lt;&gt;  ''
AND	     KOKYAKU.顧客管理番号 IS NULL
AND      URIAGE.フロアコード &lt;&gt; '9' 
GROUP BY URIAGE.顧客管理番号
UNION ALL
SELECT   @売上年月,
		 KOKYAKU.顧客管理番号,
		 SUM(URIAGE.販売金額)  AS 売上金額,
	     'BAT',
		 GETDATE()
FROM     V_売上 URIAGE
INNER JOIN  M_顧客 KOKYAKU ON URIAGE.代表顧客コード = KOKYAKU.代表顧客コード
						  AND ISNULL(KOKYAKU.削除フラグ,0) = 0
INNER JOIN  M_フロア HUROA ON URIAGE.フロアコード = HUROA.フロアコード   
WHERE	 @売上年月 + '01' &lt;= URIAGE.売上年月日
AND	     URIAGE.売上年月日 &lt;= @売上年月 + '31'
AND	     URIAGE.顧客管理番号 &lt;&gt;  ''
AND      URIAGE.フロアコード &lt;&gt; '9' 
GROUP BY KOKYAKU.顧客管理番号</CommandText>
