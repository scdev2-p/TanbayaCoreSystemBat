                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT TANA.棚卸年月
		,TANA.棚番号
		,SS.セット商品管理番号
		,MS.商品管理番号
		,MS.仕入先コード
		,MS.仕入先履歴番号
		,TANA.担当者番号
		,SS.数量 * TANA.数量 AS 数量
		,MS.原価単価 * (SS.数量 * TANA.数量) AS 原価単価合計
		,MS.上代単価 * (SS.数量 * TANA.数量) AS 上代単価合計
		,TANA.エラーメッセージ
		,TANA.入力端末番号
		,TANA.フロアコード
		,TANA.処理済みフラグ
		,'BAT' AS 登録者番号
		,GETDATE() AS 登録日

FROM M_商品 MS INNER JOIN M_セット商品 SS
	ON MS.商品管理番号 = SS.商品管理番号
	INNER JOIN (SELECT 商品管理番号, 棚卸年月, 棚番号, 担当者番号, 数量, エラーメッセージ, 入力端末番号, フロアコード, 処理済みフラグ
				FROM T_棚卸明細
				WHERE 商品管理番号 IN
				 (SELECT 商品管理番号 FROM	M_商品 WHERE セット品フラグ = 1)) TANA
	ON SS.セット商品管理番号 = TANA.商品管理番号
WHERE TANA.棚卸年月 = @棚卸年月</CommandText>
