                    <CommandText>SELECT 営業フラグ, 年月日, 支払日, 更新日, 更新者番号, 棚卸フラグ, 登録日, 登録者番号, 締日, 表示名, 除外日フラグ FROM M_カレンダ WHERE (SUBSTRING(年月日, 1, 6) = @対象年月) AND (営業フラグ = 1) AND (除外日フラグ = 0) ORDER BY 年月日 DESC</CommandText>
                    <Parameters>
