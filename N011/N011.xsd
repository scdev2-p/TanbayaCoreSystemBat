          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="来店ポイントTableAdapter" GeneratorDataComponentClassName="来店ポイントTableAdapter" Name="来店ポイント" UserDataComponentName="来店ポイントTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="tnbConnectionString (MySettings)" DbObjectName="tnb.dbo.T_来店" DbObjectType="Table" GenerateMethods="Get" GenerateShortCommands="false" GeneratorGetMethodName="SelectRaitenPoint" GetMethodModifier="Public" GetMethodName="SelectRaitenPoint" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="SelectRaitenPoint" UserSourceName="SelectRaitenPoint">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="false">
                    <CommandText>SELECT	 TR.顧客管理番号
		,来店年月日 年月日
		,0 合計金額
		,MAX(CASE WHEN SUBSTRING(MK.顧客コード,1,1) IN ( 'I','O' ) THEN 5 
		          WHEN SUBSTRING(MK.顧客コード,1,1) IN ( 'ﾜ' )     THEN 20
																   ELSE MRP.加算ポイント 
		 END) 加算ポイント
		,MAX(ISNULL(REG.使用ポイント数,0)) 使用ポイント数
		,MAX(ISNULL(REG.付与ポイント,0)) 付与ポイント
		,MAX(CASE WHEN SUBSTRING(TR.来店時分秒,1,4) BETWEEN ME.開始時分 AND ME.終了時分 
			THEN ME.ポイント掛率
			ELSE 1
		 END) ポイント掛率
FROM	 T_来店 TR
INNER JOIN M_顧客 MK ON TR.顧客管理番号 = MK.顧客管理番号
LEFT JOIN M_来店ポイント MRP ON MK.都道府県コード = MRP.都道府県コード
LEFT JOIN (SELECT	 TR.顧客管理番号
					,TR.伝票年月日
					,SUM(TR.合計金額) 合計金額
					,CAST(((SUM(TR.合計金額) - SUM(ISNULL(TRN.合計入金金額,0))) / 20000) AS INT) * 20 付与ポイント
					,SUM(TR.使用ポイント数) 使用ポイント数
					,1 ポイント掛率
			FROM	 T_レジ伝票 TR
			LEFT JOIN (SELECT	 T_レジ伝票明細.[伝票年月日]
								,T_レジ伝票明細.[出力レジ番号]
								,T_レジ伝票明細.[レジ伝票連番]
								,T_レジ伝票.[顧客管理番号]
								,SUM(T_レジ伝票明細.[金額]) AS [合計入金金額]
					   FROM		 [T_レジ伝票明細]
					   INNER JOIN [T_レジ伝票] ON  T_レジ伝票.[伝票年月日] = T_レジ伝票明細.[伝票年月日]
											   AND T_レジ伝票.[出力レジ番号] = T_レジ伝票明細.[出力レジ番号]
											   AND T_レジ伝票.[レジ伝票連番] = T_レジ伝票明細.[レジ伝票連番]
					   WHERE	 T_レジ伝票明細.[バーコード] = '00004'
					   AND		 T_レジ伝票明細.伝票年月日 = @対象年月日
					   GROUP BY	 T_レジ伝票明細.[伝票年月日]
								,T_レジ伝票明細.[出力レジ番号]
								,T_レジ伝票明細.[レジ伝票連番]
								,T_レジ伝票.[顧客管理番号]) TRN ON  TR.伝票年月日 = TRN.伝票年月日
																AND TR.出力レジ番号 = TRN.出力レジ番号
																AND TR.レジ伝票連番 = TRN.レジ伝票連番
																AND TR.顧客管理番号 = TRN.顧客管理番号
					
			WHERE	 TR.伝票年月日 = @対象年月日
			AND		 RTRIM(TR.顧客管理番号) &lt;&gt; ''
			GROUP BY TR.顧客管理番号
					,TR.伝票年月日) REG ON  TR.顧客管理番号 = REG.顧客管理番号
																						AND TR.来店年月日 = REG.伝票年月日
LEFT JOIN (SELECT	 ME.イベント年月日
					,ME.開始時分
					,ME.終了時分
					,ME.ポイント掛率
			  FROM	 M_イベント ME 
			  WHERE	 ME.イベント区分 IN ( '003','004','005','006','007' )
			  AND	 ME.イベント年月日 = @対象年月日) ME ON TR.来店年月日 = ME.イベント年月日
WHERE	 TR.来店年月日 = @対象年月日
AND		 ISNULL(MK.削除フラグ,0) = 0
GROUP BY TR.顧客管理番号
		,来店年月日
UNION ALL
SELECT	 REG.顧客管理番号
		,@対象年月日 年月日
		,0 合計金額
		,0 加算ポイント
		,MAX(ISNULL(REG.使用ポイント数,0)) 使用ポイント数
		,MAX(ISNULL(REG.付与ポイント,0)) 付与ポイント
		,MAX(CASE WHEN ME.開始時分 = '0000' AND ME.終了時分 = '2359'
			THEN ME.ポイント掛率
			ELSE 1
		 END) ポイント掛率
FROM	(SELECT	 TR.顧客管理番号
				,TR.伝票年月日
				,SUM(TR.合計金額) 合計金額
				,CAST(((SUM(TR.合計金額) - SUM(ISNULL(TRN.合計入金金額,0))) / 20000) AS INT) * 20 付与ポイント
				,SUM(TR.使用ポイント数) 使用ポイント数
				,1 ポイント掛率
		FROM	 T_レジ伝票 TR
		LEFT JOIN (SELECT	 T_レジ伝票明細.[伝票年月日]
							,T_レジ伝票明細.[出力レジ番号]
							,T_レジ伝票明細.[レジ伝票連番]
							,T_レジ伝票.[顧客管理番号]
							,SUM(T_レジ伝票明細.[金額]) AS [合計入金金額]
				   FROM		 [T_レジ伝票明細]
				   INNER JOIN [T_レジ伝票] ON  T_レジ伝票.[伝票年月日] = T_レジ伝票明細.[伝票年月日]
										   AND T_レジ伝票.[出力レジ番号] = T_レジ伝票明細.[出力レジ番号]
										   AND T_レジ伝票.[レジ伝票連番] = T_レジ伝票明細.[レジ伝票連番]
				   WHERE	 T_レジ伝票明細.[バーコード] = '00004'
				   AND		 T_レジ伝票明細.伝票年月日 = @対象年月日
				   GROUP BY	 T_レジ伝票明細.[伝票年月日]
							,T_レジ伝票明細.[出力レジ番号]
							,T_レジ伝票明細.[レジ伝票連番]
							,T_レジ伝票.[顧客管理番号]) TRN ON  TR.伝票年月日 = TRN.伝票年月日
															AND TR.出力レジ番号 = TRN.出力レジ番号
															AND TR.レジ伝票連番 = TRN.レジ伝票連番
															AND TR.顧客管理番号 = TRN.顧客管理番号
				
		WHERE	 TR.伝票年月日 = @対象年月日
		AND		 RTRIM(TR.顧客管理番号) &lt;&gt; ''
		GROUP BY TR.顧客管理番号
				,TR.伝票年月日) REG
INNER JOIN M_顧客 MK ON REG.顧客管理番号 = MK.顧客管理番号
LEFT JOIN M_来店ポイント MRP ON MK.都道府県コード = MRP.都道府県コード
LEFT JOIN T_来店 TR ON  TR.顧客管理番号 = REG.顧客管理番号
					AND TR.来店年月日 = REG.伝票年月日
					AND TR.来店年月日 = @対象年月日
LEFT JOIN (SELECT	 ME.イベント年月日
					,ME.開始時分
					,ME.終了時分
					,ME.ポイント掛率
			  FROM	 M_イベント ME 
			  WHERE	 ME.イベント区分 IN ( '003','004','005','006','007' )
			  AND	 ME.イベント年月日 = @対象年月日) ME ON REG.伝票年月日 = ME.イベント年月日
WHERE	 ISNULL(MK.削除フラグ,0) = 0
AND		 TR.顧客管理番号 IS NULL
AND		(ISNULL(REG.付与ポイント,0) &lt;&gt; 0 OR
         ISNULL(REG.使用ポイント数,0) &lt;&gt; 0)
GROUP BY REG.顧客管理番号
		,来店年月日

