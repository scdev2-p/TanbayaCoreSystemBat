            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT INTO T_日別在庫 (
		 商品管理番号
		,仕入伝票番号
		,在庫年月日
		,数量
		,群コード
		,フロアコード
		,仕入先コード
		,原価単価合計
		,販売金額合計
		,粗利金額合計
		,登録者番号
		,登録日 )
SELECT	 TZAIKO.商品管理番号
		,TZAIKO.仕入伝票番号
		,@在庫年月日
		,TZAIKO.数量
		,MSHOHIN.群コード
		,MSHOHIN.フロアコード
		,MSHOHIN.仕入先コード
		,TZAIKO.数量 * ISNULL(SHIIRE.原価単価,0) 原価単価合計
		,ISNULL(TURIAGE.販売金額,0) 販売金額合計
		,ISNULL(TURIAGE.販売金額 - (TZAIKO.数量 * ISNULL(SHIIRE.原価単価,0)),0) 粗利金額合計
		,'BAT'
		,GETDATE()
FROM	(SELECT	  商品管理番号
				 ,仕入伝票番号
				 ,SUM(数量) 数量
		 FROM     T_在庫
		 GROUP BY 商品管理番号
				 ,仕入伝票番号) TZAIKO 
INNER JOIN M_商品 MSHOHIN ON TZAIKO.商品管理番号 = MSHOHIN.商品管理番号
LEFT OUTER JOIN (SELECT  SHIIREM.仕入伝票番号
						,SHIIREM.商品管理番号
						,SHIIREM.赤黒枝番
						,SHIIREM.原価単価
						,SHIIREM.上代単価
				 FROM	 T_仕入明細 SHIIREM
				 INNER JOIN (SELECT	 H.仕入伝票番号
									,M.商品管理番号
									,H.赤黒枝番
									,MIN(M.明細番号) 明細番号
							FROM	(SELECT  仕入伝票番号
											,MAX(赤黒枝番) 赤黒枝番
									 FROM	 T_仕入
									 GROUP BY 仕入伝票番号) H
							INNER JOIN  T_仕入明細 M ON H.仕入伝票番号 = M.仕入伝票番号
					 								AND H.赤黒枝番     = M.赤黒枝番
							GROUP BY H.仕入伝票番号
									,M.商品管理番号
									,H.赤黒枝番) SHIIREM_SUB 
				  ON	 SHIIREM.仕入伝票番号 = SHIIREM_SUB.仕入伝票番号
				  AND	 SHIIREM.商品管理番号 = SHIIREM_SUB.商品管理番号
				  AND	 SHIIREM.赤黒枝番     = SHIIREM_SUB.赤黒枝番
				  AND	 SHIIREM.明細番号     = SHIIREM_SUB.明細番号) SHIIRE 
				  ON TZAIKO.商品管理番号 = SHIIRE.商品管理番号
				 AND TZAIKO.仕入伝票番号 = SHIIRE.仕入伝票番号
LEFT OUTER JOIN (SELECT		 TURIAGE.仕入伝票番号
							,TURIAGE.商品管理番号
							,SUM(TURIAGE.販売金額) 販売金額
							,SUM(TURIAGE.原価単価 * TURIAGE.数量) 原価金額
				 FROM		 T_売上 TURIAGE
				 GROUP BY 	 TURIAGE.仕入伝票番号
							,TURIAGE.商品管理番号) TURIAGE ON TZAIKO.商品管理番号 = TURIAGE.商品管理番号
														  AND TZAIKO.仕入伝票番号 = TURIAGE.仕入伝票番号</CommandText>
