            <InsertCommand>
              <DbCommand CommandType="Text" ModifiedByUser="true">
                <CommandText>INSERT  INTO T_棚卸差異 (
棚卸年月,
商品管理番号,
在庫区分,
差異数量,
登録者番号,
登録日)

SELECT @棚卸年月 AS 棚卸年月
		,ISNULL(MEISAI.商品管理番号,ZAIKO.商品管理番号) AS 商品管理番号
		,ISNULL(MEISAI.在庫区分,ZAIKO.在庫区分) AS 在庫区分
		,ISNULL(MEISAI.明細数量,0) - ISNULL(ZAIKO.在庫数量,0) AS 差異数量
		,'N053' AS 登録者番号
		,GETDATE() AS 登録日

FROM (
	SELECT 商品管理番号,SUM(ISNULL(数量,0)) AS 明細数量, '1' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND SUBSTRING(棚番号,1,1) &gt;= 1
					AND SUBSTRING(棚番号,1,1) &lt;= 8
				GROUP BY 商品管理番号
	UNION ALL
	SELECT 商品管理番号, SUM(ISNULL(数量,0)) AS 明細数量, '2' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND 棚番号 &gt;= 9000
					AND 棚番号 &lt;= 9499
				GROUP BY 商品管理番号
	UNION ALL
	SELECT 商品管理番号, SUM(ISNULL(数量,0)) AS 明細数量, '3' AS 在庫区分
				FROM T_棚卸明細
				WHERE 棚卸年月 = @棚卸年月
					AND 棚番号 &gt;= 9500
					AND 棚番号 &lt;= 9999
				GROUP BY 商品管理番号
			
	) MEISAI

FULL OUTER JOIN (
	SELECT z.商品管理番号, SUM(ISNULL(数量,0)) AS 在庫数量, 在庫区分
		FROM T_在庫 Z
		GROUP BY Z.商品管理番号, 在庫区分
	) ZAIKO
		
ON MEISAI.商品管理番号 = ZAIKO.商品管理番号
 AND MEISAI.在庫区分 = ZAIKO.在庫区分

WHERE ISNULL(MEISAI.明細数量,0) - ISNULL(ZAIKO.在庫数量,0) &lt;&gt; 0
ORDEr BY 商品管理番号</CommandText>
